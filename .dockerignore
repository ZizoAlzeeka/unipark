# UniPark Docker ignore — keep build context small and fast
.git
.gitignore
README.md
*.md

# Local dev databases
database/*.sqlite
database/unipark.sqlite

# Local env (will be created inside container from .env.example)
.env

# IDE / OS files
.idea
.vscode
.DS_Store
Thumbs.db

# Tests (not needed in production image)
tests
phpunit.xml
.phpunit.result.cache

# IMPORTANT: vendor/ is rebuilt inside the container by composer install.
# Do NOT ship the local vendor/ — it bloats the build context by ~100MB.
vendor
node_modules

# Build artifacts
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*.log
